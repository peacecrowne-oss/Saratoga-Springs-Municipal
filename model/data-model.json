{
  "schema_version": 1,
  "status": "proposed",
  "note": "A starting point derived from REQ-001 to REQ-017, for review before any table is created. Tables are named for what they store, not for the vendor systems they sync with.",
  "tables": [
    {
      "name": "asset",
      "purpose": "Every municipal asset in the inventory.",
      "requirements": ["REQ-001"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "asset_tag", "type": "text", "note": "unique, printed on the asset" },
        { "name": "name", "type": "text" },
        { "name": "category_id", "type": "uuid", "references": "asset_category" },
        { "name": "status", "type": "enum", "note": "planned, active, under_maintenance, retired" },
        { "name": "location_id", "type": "uuid", "references": "location" },
        { "name": "acquired_on", "type": "date" },
        { "name": "expected_life_years", "type": "integer" },
        { "name": "retired_on", "type": "date", "note": "null while in service" }
      ]
    },
    {
      "name": "asset_category",
      "purpose": "How assets are categorised (roads, water, fleet, buildings, …), nestable.",
      "requirements": ["REQ-001"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "name", "type": "text" },
        { "name": "parent_id", "type": "uuid", "references": "asset_category" }
      ]
    },
    {
      "name": "asset_status_change",
      "purpose": "The lifecycle history of each asset: every status it has moved through.",
      "requirements": ["REQ-001"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "asset_id", "type": "uuid", "references": "asset" },
        { "name": "from_status", "type": "enum" },
        { "name": "to_status", "type": "enum" },
        { "name": "changed_by", "type": "uuid", "references": "app_user" },
        { "name": "changed_at", "type": "timestamp" },
        { "name": "reason", "type": "text" }
      ]
    },
    {
      "name": "maintenance_record",
      "purpose": "Inspections, repairs and preventive work, and the condition found. Feeds performance and maintenance-need reports.",
      "requirements": ["REQ-002"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "asset_id", "type": "uuid", "references": "asset" },
        { "name": "kind", "type": "enum", "note": "inspection, repair, preventive" },
        { "name": "performed_on", "type": "date" },
        { "name": "condition_score", "type": "integer", "note": "e.g. 1–5" },
        { "name": "next_due_on", "type": "date" },
        { "name": "cost_entry_id", "type": "uuid", "references": "cost_entry" },
        { "name": "notes", "type": "text" }
      ]
    },
    {
      "name": "location",
      "purpose": "Where an asset or permit site is, so it can be shown on the map.",
      "requirements": ["REQ-003", "REQ-016"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "latitude", "type": "decimal" },
        { "name": "longitude", "type": "decimal" },
        { "name": "address", "type": "text" },
        { "name": "parcel_number", "type": "text" }
      ]
    },
    {
      "name": "permit_type",
      "purpose": "The kinds of permit a citizen can apply for, and what each needs.",
      "requirements": ["REQ-004", "REQ-005"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "name", "type": "text" },
        { "name": "required_documents", "type": "text[]" },
        { "name": "review_steps", "type": "json", "note": "ordered reviewer roles for the workflow" },
        { "name": "fee", "type": "decimal" }
      ]
    },
    {
      "name": "permit_application",
      "purpose": "An application submitted online, and where it is in review.",
      "requirements": ["REQ-004", "REQ-005"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "permit_type_id", "type": "uuid", "references": "permit_type" },
        { "name": "applicant_id", "type": "uuid", "references": "app_user" },
        { "name": "location_id", "type": "uuid", "references": "location" },
        { "name": "status", "type": "enum", "note": "draft, submitted, in_review, approved, rejected, withdrawn" },
        { "name": "submitted_at", "type": "timestamp" },
        { "name": "decided_at", "type": "timestamp" }
      ]
    },
    {
      "name": "review_step",
      "purpose": "Each review an application is routed through, and its decision.",
      "requirements": ["REQ-005"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "application_id", "type": "uuid", "references": "permit_application" },
        { "name": "sequence", "type": "integer" },
        { "name": "reviewer_role_id", "type": "uuid", "references": "role" },
        { "name": "assigned_to", "type": "uuid", "references": "app_user" },
        { "name": "status", "type": "enum", "note": "waiting, in_progress, done" },
        { "name": "decision", "type": "enum", "note": "approve, reject, request_changes" },
        { "name": "comments", "type": "text" },
        { "name": "decided_at", "type": "timestamp" }
      ]
    },
    {
      "name": "notification",
      "purpose": "Every status alert sent to an applicant or reviewer, and whether it was delivered.",
      "requirements": ["REQ-006"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "recipient_id", "type": "uuid", "references": "app_user" },
        { "name": "application_id", "type": "uuid", "references": "permit_application" },
        { "name": "channel", "type": "enum", "note": "email, sms, in_app" },
        { "name": "subject", "type": "text" },
        { "name": "sent_at", "type": "timestamp" },
        { "name": "delivery_status", "type": "enum", "note": "queued, sent, failed" }
      ]
    },
    {
      "name": "document",
      "purpose": "A permit-related document; the file itself lives in the document management system.",
      "requirements": ["REQ-008"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "application_id", "type": "uuid", "references": "permit_application" },
        { "name": "kind", "type": "text", "note": "site plan, proof of insurance, …" },
        { "name": "file_name", "type": "text" },
        { "name": "uploaded_by", "type": "uuid", "references": "app_user" },
        { "name": "uploaded_at", "type": "timestamp" }
      ]
    },
    {
      "name": "budget_line",
      "purpose": "An approved budget amount for a department, account and year.",
      "requirements": ["REQ-007", "REQ-017"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "fiscal_year", "type": "integer" },
        { "name": "department", "type": "text" },
        { "name": "account_code", "type": "text" },
        { "name": "amount", "type": "decimal" }
      ]
    },
    {
      "name": "cost_entry",
      "purpose": "Money actually spent, against a budget line and optionally an asset.",
      "requirements": ["REQ-007", "REQ-017"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "budget_line_id", "type": "uuid", "references": "budget_line" },
        { "name": "asset_id", "type": "uuid", "references": "asset" },
        { "name": "capital_project_id", "type": "uuid", "references": "capital_project" },
        { "name": "amount", "type": "decimal" },
        { "name": "incurred_on", "type": "date" }
      ]
    },
    {
      "name": "capital_project",
      "purpose": "A project that builds, replaces or repairs assets, tracked in the project management system.",
      "requirements": ["REQ-015"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "name", "type": "text" },
        { "name": "status", "type": "enum", "note": "planned, active, complete" },
        { "name": "starts_on", "type": "date" },
        { "name": "ends_on", "type": "date" }
      ]
    },
    {
      "name": "project_asset",
      "purpose": "Which assets a capital project touches.",
      "requirements": ["REQ-015"],
      "fields": [
        { "name": "capital_project_id", "type": "uuid", "references": "capital_project", "key": "pk" },
        { "name": "asset_id", "type": "uuid", "references": "asset", "key": "pk" }
      ]
    },
    {
      "name": "app_user",
      "purpose": "Anyone who signs in: staff, reviewers and citizens.",
      "requirements": ["REQ-009"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "email", "type": "text" },
        { "name": "display_name", "type": "text" },
        { "name": "kind", "type": "enum", "note": "staff, citizen" },
        { "name": "active", "type": "boolean" }
      ]
    },
    {
      "name": "role",
      "purpose": "A role such as asset manager, permit reviewer or financial manager, and what it may do.",
      "requirements": ["REQ-009"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "name", "type": "text" },
        { "name": "permissions", "type": "text[]", "note": "e.g. asset.edit, permit.approve" }
      ]
    },
    {
      "name": "user_role",
      "purpose": "Which roles each user holds.",
      "requirements": ["REQ-009"],
      "fields": [
        { "name": "user_id", "type": "uuid", "references": "app_user", "key": "pk" },
        { "name": "role_id", "type": "uuid", "references": "role", "key": "pk" }
      ]
    },
    {
      "name": "audit_event",
      "purpose": "Append-only record of who did what to which record, and when.",
      "requirements": ["REQ-010"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "actor_id", "type": "uuid", "references": "app_user" },
        { "name": "action", "type": "text", "note": "create, update, delete, approve, sign_in, …" },
        { "name": "entity_type", "type": "text" },
        { "name": "entity_id", "type": "uuid" },
        { "name": "before", "type": "json" },
        { "name": "after", "type": "json" },
        { "name": "occurred_at", "type": "timestamp" }
      ]
    },
    {
      "name": "dashboard",
      "purpose": "A user's customised dashboard.",
      "requirements": ["REQ-011"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "owner_id", "type": "uuid", "references": "app_user" },
        { "name": "name", "type": "text" }
      ]
    },
    {
      "name": "dashboard_widget",
      "purpose": "One chart or figure on a dashboard, and the report it shows.",
      "requirements": ["REQ-011"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "dashboard_id", "type": "uuid", "references": "dashboard" },
        { "name": "report_definition_id", "type": "uuid", "references": "report_definition" },
        { "name": "kind", "type": "enum", "note": "number, bar, line, map, table" },
        { "name": "position", "type": "json" }
      ]
    },
    {
      "name": "report_definition",
      "purpose": "A pre-defined or ad-hoc report over asset and permit data.",
      "requirements": ["REQ-002", "REQ-012"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "name", "type": "text" },
        { "name": "kind", "type": "enum", "note": "predefined, adhoc" },
        { "name": "query", "type": "json" },
        { "name": "created_by", "type": "uuid", "references": "app_user" }
      ]
    },
    {
      "name": "report_run",
      "purpose": "Each time a report was produced, by whom, and where the output is.",
      "requirements": ["REQ-012"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "report_definition_id", "type": "uuid", "references": "report_definition" },
        { "name": "run_by", "type": "uuid", "references": "app_user" },
        { "name": "run_at", "type": "timestamp" },
        { "name": "output_ref", "type": "text" }
      ]
    },
    {
      "name": "external_record_link",
      "purpose": "Ties a record here to its copy in an outside system (asset/permitting suite, project management, GIS, finance, document store) and when it last synced.",
      "requirements": ["REQ-003", "REQ-007", "REQ-008", "REQ-014", "REQ-015", "REQ-016", "REQ-017"],
      "fields": [
        { "name": "id", "type": "uuid", "key": "pk" },
        { "name": "external_system", "type": "enum", "note": "asset_permitting_suite, project_management, gis, finance, document_store" },
        { "name": "external_id", "type": "text" },
        { "name": "entity_type", "type": "text", "note": "asset, permit_application, document, cost_entry, capital_project, location" },
        { "name": "entity_id", "type": "uuid" },
        { "name": "last_synced_at", "type": "timestamp" },
        { "name": "sync_status", "type": "enum", "note": "ok, pending, error" }
      ]
    }
  ]
}
